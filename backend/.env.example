# Copy this file to .env and paste your Supabase PostgreSQL URI from Project → Connect.
# Use the session pooler URI for a local Windows machine if direct IPv6 connectivity is unavailable.
SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require

# Keep these credentials on the backend only. Never put the database URI in frontend/.env.
ANNSETU_ADMIN_EMAIL=admin@example.org
ANNSETU_ADMIN_PASSWORD=replace-with-a-unique-password

# Optional TrustVerify AI extraction and report summary.
# Configure this only if document excerpts may be sent to Groq after common
# PAN, email, phone, and 12-digit identifiers are redacted.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional government-domain search. Search results are evidence leads,
# not direct confirmation from an official registry API.
TAVILY_API_KEY=

# Optional LangSmith tracing; disabled unless explicitly enabled below.
LANGSMITH_API_KEY=
ANNSETU_ENABLE_LANGSMITH_TRACING=false

# Optional path to the Tesseract executable if it is not available on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
